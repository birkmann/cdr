{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app commands plus dialogs, notifications and opening URLs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "notification:default",
    "opener:default",
    "core:webview:allow-set-webview-zoom"
  ]
}
