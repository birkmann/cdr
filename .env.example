# Copy to .env if you do not already have one; never commit real credentials.
# Existing shell variables take priority. CDR also loads ~/.harness/.env
# (or $CDR_HOME/.env). Restart cdr serve after changing credentials.

# Configure only the model providers you use.
DEEPSEEK_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional: real photography for generated pages (https://unsplash.com/oauth/applications).
# Public photo search and selection use only the Access Key, on the server.
UNSPLASH_ACCESS_KEY=
# Optional OAuth Secret Key; not required or used by CDR's image tools.
UNSPLASH_SECRET_KEY=
