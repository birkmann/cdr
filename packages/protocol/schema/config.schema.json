{
  "$ref": "#/definitions/HarnessConfig",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HarnessConfig": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "additionalProperties": false,
          "description": "Subagent limits (spawn_agent).",
          "properties": {
            "maxActive": {
              "description": "Running agents (conversations and subagents) in one harness process above which spawn_agent refuses to start another (default 8). Conversations you start yourself are never refused.",
              "type": "number"
            },
            "maxConcurrent": {
              "description": "Concurrently running subagents per parent session (default 3).",
              "type": "number"
            },
            "maxDepth": {
              "description": "Maximum nesting depth; a session at this depth cannot spawn (default 2).",
              "type": "number"
            }
          },
          "type": "object"
        },
        "checkpoints": {
          "additionalProperties": false,
          "description": "Workspace checkpoints before every turn, restorable from the UIs (default enabled).",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "context": {
          "additionalProperties": false,
          "properties": {
            "compactAt": {
              "description": "Fraction of the context budget at which compaction starts (default 0.7).",
              "type": "number"
            },
            "keepRecent": {
              "description": "Most recent messages kept verbatim when compacting (default 6).",
              "type": "number"
            },
            "maxContext": {
              "description": "Absolute working-context budget in tokens. The agent compacts at `compactAt` × min(model context window, maxContext). Default 64000; 0 uses the model's context window alone. Smaller budgets keep the per-call cost of long jobs flat with little accuracy loss on frontier models.",
              "type": "number"
            },
            "maxToolOutput": {
              "type": "number"
            },
            "reasoningSummaries": {
              "description": "Summarise long thinking into short decision lines for the user (summarizer model). Default true.",
              "type": "boolean"
            },
            "repoMapDepth": {
              "type": "number"
            }
          },
          "type": "object"
        },
        "hooks": {
          "$ref": "#/definitions/HooksConfig"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "continueAfterMaxTurns": {
              "description": "Keep going past `maxTurns` while the agent is making progress (default true). Time, token and cost limits still apply.",
              "type": "boolean"
            },
            "maxCost": {
              "description": "Optional local per-run cost estimate using configured model prices. Omitted or 0 disables it; not the provider account balance.",
              "type": "number"
            },
            "maxTokens": {
              "description": "Optional local per-run total of input + output tokens across all calls. Omitted or 0 disables it; not a provider balance or context-window limit.",
              "type": "number"
            },
            "maxTotalTurns": {
              "description": "Hard cap on turns across all checkpoints when continuing (default 1500; 0 = no cap).",
              "type": "number"
            },
            "maxTurns": {
              "description": "Model turns per checkpoint. At each checkpoint an agent that changed files since the last one keeps going (see `continueAfterMaxTurns`); one that changed nothing stops. Default 150.",
              "type": "number"
            },
            "timeoutMs": {
              "description": "Active run time in milliseconds; excludes time waiting for human input.",
              "type": "number"
            }
          },
          "type": "object"
        },
        "mcpServers": {
          "additionalProperties": {
            "$ref": "#/definitions/McpServerConfig"
          },
          "type": "object"
        },
        "models": {
          "additionalProperties": false,
          "properties": {
            "executor": {
              "type": "string"
            },
            "planner": {
              "type": "string"
            },
            "reviewer": {
              "type": "string"
            },
            "summarizer": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "outputDir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "const": false,
              "type": "boolean"
            }
          ],
          "description": "Folder for files a chat creates (poems, notes, drafts), so Chat mode does not add files to the repository. Each chat gets its own subfolder; edits to files that already exist in the project still go to the project. Absolute or `~/` path. The terminal app defaults to `$CDR_OUTPUT_DIR` or `~/Documents/CDR`; other front ends leave it unset. `false` turns it off, so new files go into the project."
        },
        "permissions": {
          "$ref": "#/definitions/PermissionsConfig"
        },
        "providers": {
          "additionalProperties": {
            "$ref": "#/definitions/ProviderConfig"
          },
          "type": "object"
        },
        "reasoningEffort": {
          "$ref": "#/definitions/ReasoningEffort"
        },
        "recreate": {
          "$ref": "#/definitions/RecreateConfig",
          "description": "1:1 recreation of live web pages"
        },
        "sandbox": {
          "enum": [
            "none",
            "bwrap"
          ],
          "type": "string"
        },
        "sandboxNetwork": {
          "description": "Allow network access inside the bwrap sandbox (package installs).",
          "type": "boolean"
        },
        "skills": {
          "additionalProperties": false,
          "description": "Skills (SKILL.md folders) offered to agents. Built-in, ~/.harness/skills and <project>/.harness/skills are always searched.",
          "properties": {
            "disabled": {
              "description": "Skill names to hide.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "enabled": {
              "description": "Set to false to disable skills entirely.",
              "type": "boolean"
            },
            "paths": {
              "description": "Extra folders containing skill folders (relative to the project root, or absolute).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "temperature": {
          "type": "number"
        },
        "verify": {
          "$ref": "#/definitions/VerifyConfig"
        },
        "workflow": {
          "type": "string"
        },
        "workflows": {
          "additionalProperties": {
            "$ref": "#/definitions/WorkflowDef"
          },
          "type": "object"
        }
      },
      "required": [
        "providers",
        "models"
      ],
      "type": "object"
    },
    "HooksConfig": {
      "additionalProperties": false,
      "properties": {
        "afterEdit": {
          "description": "Shell command run after a successful write/patch; output is appended to the tool result.",
          "type": "string"
        },
        "onStop": {
          "description": "Shell command run when an agent run finishes.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "McpServerConfig": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "url": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "contextWindow": {
          "type": "number"
        },
        "inputPrice": {
          "type": "number"
        },
        "maxTokens": {
          "type": "number"
        },
        "outputPrice": {
          "type": "number"
        },
        "reasoning": {
          "type": "boolean"
        },
        "reasoningEfforts": {
          "description": "Supported reasoning_effort values for an OpenAI-compatible model.",
          "items": {
            "description": "auto leaves provider defaults unchanged; none disables thinking where supported.",
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "max"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "tools": {
          "type": "boolean"
        },
        "vision": {
          "description": "Accepts image input.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ModelRole": {
      "enum": [
        "executor",
        "planner",
        "reviewer",
        "summarizer"
      ],
      "type": "string"
    },
    "PermissionsConfig": {
      "additionalProperties": false,
      "properties": {
        "bash": {
          "additionalProperties": false,
          "properties": {
            "allow": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "deny": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "mode": {
          "enum": [
            "ask",
            "auto",
            "yolo"
          ],
          "type": "string"
        },
        "tools": {
          "additionalProperties": {
            "enum": [
              "allow",
              "ask",
              "deny"
            ],
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "Phase": {
      "enum": [
        "plan",
        "execute",
        "verify",
        "review",
        "finish"
      ],
      "type": "string"
    },
    "PhaseDef": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelRole"
            },
            {
              "type": "string"
            }
          ]
        },
        "phase": {
          "$ref": "#/definitions/Phase"
        },
        "prompt": {
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "phase"
      ],
      "type": "object"
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "apiKey": {
          "type": "string"
        },
        "apiKeyEnv": {
          "type": "string"
        },
        "baseURL": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/definitions/ModelInfo"
          },
          "description": "Per-model overrides (context window, tool support, pricing per 1M tokens).",
          "type": "object"
        },
        "type": {
          "enum": [
            "openai-compatible",
            "anthropic",
            "mock"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "ReasoningEffort": {
      "description": "auto leaves provider defaults unchanged; none disables thinking where supported.",
      "enum": [
        "auto",
        "none",
        "low",
        "medium",
        "high",
        "max"
      ],
      "type": "string"
    },
    "RecreateConfig": {
      "additionalProperties": false,
      "description": "`recreate` section of the config.",
      "properties": {
        "allowLocal": {
          "description": "allow capturing localhost / private-network URLs (your own site; default false)",
          "type": "boolean"
        },
        "assets": {
          "description": "run-dir: captured assets stay in the gitignored run folder; project: copied into the output; none: placeholders",
          "enum": [
            "run-dir",
            "project",
            "none"
          ],
          "type": "string"
        },
        "budgets": {
          "additionalProperties": false,
          "properties": {
            "altMs": {
              "type": "number"
            },
            "menuMs": {
              "type": "number"
            },
            "rasters": {
              "type": "number"
            },
            "regionMs": {
              "type": "number"
            },
            "submenuMs": {
              "type": "number"
            },
            "submenus": {
              "type": "number"
            },
            "totalMs": {
              "type": "number"
            }
          },
          "type": "object"
        },
        "captureParallel": {
          "description": "capture sessions (device classes) run at once, each in its own browser (default 3)",
          "type": "number"
        },
        "driver": {
          "description": "capture driver: cdp (local Chrome, default) or remote (POST to a capture service)",
          "enum": [
            "cdp",
            "remote"
          ],
          "type": "string"
        },
        "emitters": {
          "description": "extra emitter modules (paths relative to the project root)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "description": "false hides the tools, the command and the UI entry points (default true)",
          "type": "boolean"
        },
        "fonts": {
          "description": "embed: font files in the output (default; most sites refuse cross-origin font loads); reference:",
          "enum": [
            "reference",
            "embed",
            "system"
          ],
          "type": "string"
        },
        "gates": {
          "additionalProperties": false,
          "properties": {
            "heightPct": {
              "type": "number"
            },
            "pixel": {
              "type": "number"
            },
            "responsivePixel": {
              "type": "number"
            },
            "singleUse": {
              "type": "number"
            },
            "text": {
              "type": "number"
            }
          },
          "type": "object"
        },
        "models": {
          "additionalProperties": false,
          "description": "model roles (or model refs) per stage",
          "properties": {
            "naming": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelRole"
                },
                {
                  "type": "string"
                }
              ]
            },
            "repair": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelRole"
                },
                {
                  "type": "string"
                }
              ]
            },
            "vision": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelRole"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "type": "object"
        },
        "remoteUrl": {
          "description": "remote driver endpoint",
          "type": "string"
        },
        "respectRobots": {
          "description": "do not capture URLs robots.txt disallows for every crawler (default true)",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "VerifyConfig": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "maxAttempts": {
          "type": "number"
        },
        "test": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "WorkflowDef": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "freshContextPerStep": {
          "description": "Run each plan step in a fresh execute context.",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "phases": {
          "items": {
            "$ref": "#/definitions/PhaseDef"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "phases"
      ],
      "type": "object"
    }
  }
}