  "exampleHtml": "<div class=\"paragraph paragraph--type--hero paragraph--view-mode--default\" data-paragraph-id=\"101\">\n  <div class=\"hero__media\"><div class=\"field field--name-field-image field--type-entity-reference field--label-hidden field__item\"><article class=\"media media--type-image media--view-mode-default\">\n  <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">  <img loading=\"eager\" src=\"/sites/default/files/2024-05/hero-breakfast.jpg\" width=\"1600\" height=\"800\" alt=\"A bowl of cereal with berries\">\n</div>\n</article>\n</div></div>\n  <div class=\"hero__content container\">\n    <h2 class=\"hero__title field field--name-field-title field--type-string field--label-hidden field__item\">Start your day right</h2>\n    <div class=\"hero__subtitle field field--name-field-subtitle field--type-string-long field--label-hidden field__item\">Simple breakfast ideas that keep you going.</div>\n    <div class=\"hero__cta field field--name-field-cta field--type-link field--label-hidden field__item\"><a href=\"/news/healthy-breakfast\" class=\"button button--primary\">Read our tips</a></div>\n  </div>\n</div>",
