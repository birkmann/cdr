  "template": "<header id=\"header\" class=\"site-header\" data-drupal-selector=\"site-header\" role=\"banner\">\n            <div class=\"site-header__container container\">\n              <div class=\"region region--header\">\n                <div id=\"block-demo-site-branding\" class=\"block block-system block-system-branding-block site-branding\">\n                  <a href=\"{{homeUrl}}\" rel=\"home\" class=\"site-branding__logo\"><img src=\"{{logo.url}}\" alt=\"{{logo.alt}}\" width=\"{{logo.width}}\" height=\"{{logo.height}}\" fetchpriority=\"high\"></a>\n                  <div class=\"site-branding__text\">\n                    <div class=\"site-branding__name\"><a href=\"{{homeUrl}}\" rel=\"home\" title=\"{{t.home}}\">{{siteName}}</a></div>\n                    <div class=\"site-branding__slogan\">{{slogan}}</div>\n                  </div>\n                </div>\n                <button class=\"mobile-nav-button\" data-drupal-selector=\"mobile-nav-button\" aria-label=\"{{t.mainNavigation}}\" aria-controls=\"header-nav\" aria-expanded=\"false\">\n                  <span class=\"mobile-nav-button__label\">{{t.menu}}</span>\n                  <span class=\"mobile-nav-button__icon\"></span>\n                </button>\n                <div id=\"header-nav\" class=\"header-nav\" data-drupal-selector=\"header-nav\">\n                  {{{mainNav}}}\n                  {{{languageSwitcher}}}\n                </div>\n              </div>\n            </div>\n          </header>",
