{
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#d98b3a",
      "$extensions": {
        "cmp.cssVar": "--color-accent"
      }
    },
    "accent-dark": {
      "$type": "color",
      "$value": "#b8722b",
      "$extensions": {
        "cmp.cssVar": "--color-accent-dark"
      }
    },
    "bg": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "cmp.cssVar": "--color-bg"
      }
    },
    "border": {
      "$type": "color",
      "$value": "#e3ddd3",
      "$extensions": {
        "cmp.cssVar": "--color-border"
      }
    },
    "on-dark": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "cmp.cssVar": "--color-on-dark"
      }
    },
    "primary": {
      "$type": "color",
      "$value": "#1f4e79",
      "$extensions": {
        "cmp.cssVar": "--color-primary"
      }
    },
    "primary-dark": {
      "$type": "color",
      "$value": "#163a5a",
      "$extensions": {
        "cmp.cssVar": "--color-primary-dark"
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#f5f1ea",
      "$extensions": {
        "cmp.cssVar": "--color-surface"
      }
    },
    "text": {
      "$type": "color",
      "$value": "#1d1d1f",
      "$extensions": {
        "cmp.cssVar": "--color-text"
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": "#5b6470",
      "$extensions": {
        "cmp.cssVar": "--color-text-muted"
      }
    },
    "semantic": {
      "text": {
        "$type": "color",
        "$value": "#1d1d1f",
        "$extensions": {
          "cmp.source": "body.color"
        }
      },
      "background": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "cmp.source": "body.backgroundColor"
        }
      },
      "link": {
        "$type": "color",
        "$value": "#1f4e79",
        "$extensions": {
          "cmp.source": "a.color"
        }
      },
      "heading": {
        "$type": "color",
        "$value": "#1d1d1f",
        "$extensions": {
          "cmp.source": "h1.color"
        }
      },
      "buttonBackground": {
        "$type": "color",
        "$value": "#d98b3a",
        "$extensions": {
          "cmp.source": "buttonPrimary.backgroundColor"
        }
      },
      "headerBackground": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "cmp.source": "header.backgroundColor"
        }
      },
      "footerBackground": {
        "$type": "color",
        "$value": "#163a5a",
        "$extensions": {
          "cmp.source": "footer.backgroundColor"
        }
      }
    },
    "palette": {
      "1": {
        "$type": "color",
        "$value": "#1d1d1f",
        "$extensions": {
          "cmp.source": "histogram"
        }
      },
      "2": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "cmp.source": "histogram"
        }
      },
      "3": {
        "$type": "color",
        "$value": "#5b6470",
        "$extensions": {
          "cmp.source": "histogram"
        }
      },
      "4": {
        "$type": "color",
        "$value": "#1f4e79",
        "$extensions": {
          "cmp.source": "histogram"
        }
      },
      "5": {
        "$type": "color",
        "$value": "#f5f1ea",
        "$extensions": {
          "cmp.source": "histogram"
        }
      },
      "6": {
        "$type": "color",
        "$value": "#d98b3a",
        "$extensions": {
          "cmp.source": "histogram"
        }
      },
      "7": {
        "$type": "color",
        "$value": "#163a5a",
        "$extensions": {
          "cmp.source": "histogram"
        }
      }
    }
  },
  "size": {
    "max": {
      "$type": "dimension",
      "$value": "1200px",
      "$extensions": {
        "cmp.cssVar": "--container-max"
      }
    },
    "narrow": {
      "$type": "dimension",
      "$value": "760px",
      "$extensions": {
        "cmp.cssVar": "--container-narrow"
      }
    },
    "gutter": {
      "$type": "dimension",
      "$value": "32px",
      "$extensions": {
        "cmp.cssVar": "--gutter",
        "cmp.responsive": {
          "mobile": "16px",
          "tablet": "24px",
          "desktop": "32px"
        }
      }
    }
  },
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "$extensions": {
        "cmp.cssVar": "--font-sans"
      }
    }
  },
  "fontSize": {
    "base": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "cmp.cssVar": "--font-size-base"
      }
    },
    "h1": {
      "$type": "dimension",
      "$value": "48px",
      "$extensions": {
        "cmp.cssVar": "--font-size-h1",
        "cmp.responsive": {
          "mobile": "32px",
          "tablet": "40px",
          "desktop": "48px"
        }
      }
    },
    "h2": {
      "$type": "dimension",
      "$value": "34px",
      "$extensions": {
        "cmp.cssVar": "--font-size-h2",
        "cmp.responsive": {
          "mobile": "26px",
          "tablet": "30px",
          "desktop": "34px"
        }
      }
    },
    "h3": {
      "$type": "dimension",
      "$value": "22px",
      "$extensions": {
        "cmp.cssVar": "--font-size-h3",
        "cmp.responsive": {
          "mobile": "20px",
          "tablet": "20px",
          "desktop": "22px"
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "18px",
      "$extensions": {
        "cmp.cssVar": "--font-size-lg"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": "14px",
      "$extensions": {
        "cmp.cssVar": "--font-size-sm"
      }
    }
  },
  "lineHeight": {
    "base": {
      "$type": "number",
      "$value": 1.6,
      "$extensions": {
        "cmp.cssVar": "--line-height-base"
      }
    },
    "tight": {
      "$type": "number",
      "$value": 1.2,
      "$extensions": {
        "cmp.cssVar": "--line-height-tight"
      }
    }
  },
  "radius": {
    "lg": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "cmp.cssVar": "--radius-lg"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "cmp.cssVar": "--radius-md"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$extensions": {
        "cmp.cssVar": "--radius-sm"
      }
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "#1d1d1f14",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "0px"
      },
      "$extensions": {
        "cmp.cssVar": "--shadow-card"
      }
    },
    "raised": {
      "$type": "shadow",
      "$value": {
        "color": "#1d1d1f29",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      },
      "$extensions": {
        "cmp.cssVar": "--shadow-raised"
      }
    }
  },
  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "4px",
      "$extensions": {
        "cmp.cssVar": "--space-1"
      }
    },
    "2": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "cmp.cssVar": "--space-2"
      }
    },
    "3": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "cmp.cssVar": "--space-3"
      }
    },
    "4": {
      "$type": "dimension",
      "$value": "24px",
      "$extensions": {
        "cmp.cssVar": "--space-4"
      }
    },
    "5": {
      "$type": "dimension",
      "$value": "32px",
      "$extensions": {
        "cmp.cssVar": "--space-5"
      }
    },
    "6": {
      "$type": "dimension",
      "$value": "48px",
      "$extensions": {
        "cmp.cssVar": "--space-6"
      }
    },
    "7": {
      "$type": "dimension",
      "$value": "64px",
      "$extensions": {
        "cmp.cssVar": "--space-7"
      }
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": "25.6px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": "body"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "48px",
        "fontWeight": 600,
        "lineHeight": "57.6px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": "h1:not(.visually-hidden)",
        "cmp.responsive": {
          "mobile": "32px",
          "tablet": "40px",
          "desktop": "48px"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "48px",
        "fontWeight": 600,
        "lineHeight": "57.6px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": "h2:not(.visually-hidden)",
        "cmp.responsive": {
          "mobile": "32px",
          "tablet": "40px",
          "desktop": "48px"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "22px",
        "fontWeight": 600,
        "lineHeight": "26.4px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": "h3:not(.visually-hidden)",
        "cmp.responsive": {
          "mobile": "20px",
          "tablet": "20px",
          "desktop": "22px"
        }
      }
    },
    "p": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": "25.6px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": "main p, [role=main] p, p"
      }
    },
    "a": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": "25.6px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": ".text-content p a, main p a, [role=main] p a, main a:not(.button)"
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "16px",
        "fontWeight": 600,
        "lineHeight": "19.2px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": ".button, button"
      }
    },
    "navLink": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "16px",
        "fontWeight": 600,
        "lineHeight": "25.6px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": "nav a, [role=navigation] a"
      }
    },
    "footerLink": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": "25.6px",
        "letterSpacing": "0px"
      },
      "$extensions": {
        "cmp.selector": "footer a"
      }
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "breakpoint": {
    "tablet": {
      "$type": "dimension",
      "$value": "768px",
      "$extensions": {
        "cmp.mediaQuery": "(min-width: 768px)"
      }
    },
    "desktop": {
      "$type": "dimension",
      "$value": "1200px",
      "$extensions": {
        "cmp.mediaQuery": "(min-width: 1200px)"
      }
    }
  }
}
