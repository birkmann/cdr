  "exampleHtml": "\n    <a href=\"#main-content\" class=\"visually-hidden focusable skip-link\">Skip to main content</a>\n    <div class=\"dialog-off-canvas-main-canvas\" data-off-canvas-main-canvas=\"\">\n      <div id=\"page-wrapper\" class=\"page-wrapper\">\n        <div id=\"page\">\n          <header id=\"header\" class=\"site-header\" data-drupal-selector=\"site-header\" role=\"banner\">\n            <div class=\"site-header__container container\">\n              <div class=\"region region--header\">\n                <div id=\"block-demo-site-branding\" class=\"block block-system block-system-branding-block site-branding\">\n                  <a href=\"/\" rel=\"home\" class=\"site-branding__logo\"><img src=\"/sites/default/files/logo.svg\" alt=\"Acme Demo Kitchen logo\" width=\"160\" height=\"40\" fetchpriority=\"high\"></a>\n                  <div class=\"site-branding__text\">\n                    <div class=\"site-branding__name\"><a href=\"/\" rel=\"home\" title=\"Home\">Acme Demo Kitchen</a></div>\n                    <div class=\"site-branding__slogan\">Good food, good life</div>\n                  </div>\n                </div>\n                <button class=\"mobile-nav-button\" data-drupal-selector=\"mobile-nav-button\" aria-label=\"Main navigation\" aria-controls=\"header-nav\" aria-expanded=\"false\">\n                  <span class=\"mobile-nav-button__label\">Menu</span>\n                  <span class=\"mobile-nav-button__icon\"></span>\n                </button>\n                <div id=\"header-nav\" class=\"header-nav\" data-drupal-selector=\"header-nav\">\n                  <nav role=\"navigation\" aria-labelledby=\"block-demo-main-menu-menu\" id=\"block-demo-main-menu\" class=\"block block-menu navigation menu--main primary-nav\">\n                    <h2 class=\"visually-hidden block__title\" id=\"block-demo-main-menu-menu\">Main navigation</h2>\n                    <ul class=\"menu primary-nav__menu primary-nav__menu--level-1\" data-drupal-selector=\"primary-nav-menu--level-1\">\n          <li class=\"menu-item primary-nav__menu-item primary-nav__menu-item--link primary-nav__menu-item--level-1 menu-item--active-trail\">\n            <a href=\"/\" class=\"primary-nav__menu-link primary-nav__menu-link--link primary-nav__menu-link--level-1 is-active\" data-drupal-link-system-path=\"<front>\" aria-current=\"page\">Home</a>\n          </li>\n          <li class=\"menu-item primary-nav__menu-item primary-nav__menu-item--link primary-nav__menu-item--level-1\">\n            <a href=\"/about-us\" class=\"primary-nav__menu-link primary-nav__menu-link--link primary-nav__menu-link--level-1\" data-drupal-link-system-path=\"node/2\">About us</a>\n          </li>\n          <li class=\"menu-item primary-nav__menu-item primary-nav__menu-item--link primary-nav__menu-item--level-1 menu-item--expanded primary-nav__menu-item--has-children\">\n            <a href=\"/news\" class=\"primary-nav__menu-link primary-nav__menu-link--link primary-nav__menu-link--level-1\" data-drupal-link-system-path=\"news\">News</a>\n            <ul class=\"menu primary-nav__menu primary-nav__menu--level-2\">\n          <li class=\"menu-item primary-nav__menu-item primary-nav__menu-item--link primary-nav__menu-item--level-2\">\n            <a href=\"/news/healthy-breakfast\" class=\"primary-nav__menu-link primary-nav__menu-link--link primary-nav__menu-link--level-2\" data-drupal-link-system-path=\"node/3\">Healthy breakfast</a>\n          </li>\n            </ul>\n          </li>\n                    </ul>\n                  </nav>\n                  <div class=\"language-switcher-language-url block block-language block-language-blocklanguage-interface\" id=\"block-demo-languageswitcher\" role=\"navigation\" aria-label=\"Language switcher\">\n  <ul class=\"links language-switcher__links\"><li hreflang=\"en\" data-drupal-link-system-path=\"<front>\" class=\"en is-active\" aria-current=\"page\"><a href=\"/\" class=\"language-link is-active\" hreflang=\"en\" data-drupal-link-system-path=\"<front>\">English</a></li><li hreflang=\"de\" data-drupal-link-system-path=\"<front>\" class=\"de\"><a href=\"/de\" class=\"language-link\" hreflang=\"de\" data-drupal-link-system-path=\"<front>\">Deutsch</a></li></ul>\n</div>\n                </div>\n              </div>\n            </div>\n          </header>\n          <div id=\"main-wrapper\" class=\"layout-main-wrapper layout-container\">\n            <div id=\"main\" class=\"layout-main\">\n              <main role=\"main\" class=\"main-content\">\n                <a id=\"main-content\" tabindex=\"-1\"></a>\n                <div class=\"region region--content-above container\">\n                  <div id=\"block-demo-page-title\" class=\"block block-core block-page-title-block\">\n                    <h1 class=\"title page-title visually-hidden\"><span class=\"field field--name-title field--type-string field--label-hidden\">Home</span></h1>\n                  </div>\n                </div>\n                <div class=\"region region--content\" id=\"content\">\n                  <div data-drupal-messages-fallback=\"\" class=\"hidden messages-list\"></div>\n                  <div id=\"block-demo-content\" class=\"block block-system block-system-main-block\">\n<article data-history-node-id=\"1\" class=\"node node--type-landing-page node--view-mode-full\">\n  <div class=\"node__content\">\n    <div class=\"field field--name-field-sections field--type-entity-reference-revisions field--label-hidden field__items\">\n      <div class=\"field__item\"><div class=\"paragraph paragraph--type--hero paragraph--view-mode--default\" data-paragraph-id=\"101\">\n  <div class=\"hero__media\"><div class=\"field field--name-field-image field--type-entity-reference field--label-hidden field__item\"><article class=\"media media--type-image media--view-mode-default\">\n  <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">  <img loading=\"eager\" src=\"/sites/default/files/2024-05/hero-breakfast.jpg\" width=\"1600\" height=\"800\" alt=\"A bowl of cereal with berries\">\n</div>\n</article>\n</div></div>\n  <div class=\"hero__content container\">\n    <h2 class=\"hero__title field field--name-field-title field--type-string field--label-hidden field__item\">Start your day right</h2>\n    <div class=\"hero__subtitle field field--name-field-subtitle field--type-string-long field--label-hidden field__item\">Simple breakfast ideas that keep you going.</div>\n    <div class=\"hero__cta field field--name-field-cta field--type-link field--label-hidden field__item\"><a href=\"/news/healthy-breakfast\" class=\"button button--primary\">Read our tips</a></div>\n  </div>\n</div></div>\n      <div class=\"field__item\"><div class=\"paragraph paragraph--type--text paragraph--view-mode--default\" data-paragraph-id=\"102\">\n  <div class=\"container\">\n    <div class=\"clearfix text-formatted text-content field field--name-field-body field--type-text-long field--label-hidden field__item\"><h2>Why breakfast matters</h2><p>A balanced breakfast gives you <strong>energy</strong> and helps you <em>focus</em>. Learn more <a href=\"/node/2\">about us</a>.</p></div>\n  </div>\n</div></div>\n      <div class=\"field__item\"><div class=\"paragraph paragraph--type--teaser-list paragraph--view-mode--default\" data-paragraph-id=\"103\">\n  <div class=\"container\">\n    <h2 class=\"teaser-list__heading field field--name-field-heading field--type-string field--label-hidden field__item\">Latest articles</h2>\n    <div class=\"field field--name-field-view field--type-viewsreference field--label-hidden field__item\"><div class=\"views-element-container\"><div class=\"view view-articles view-id-articles view-display-id-block_latest js-view-dom-id-articles-block_latest\">\n    <div class=\"view-content grid-teasers\">\n      <div class=\"views-row\"><article data-history-node-id=\"4\" class=\"node node--type-article node--promoted node--view-mode-teaser teaser\">\n  <div class=\"teaser__image\"><div class=\"field field--name-field-image field--type-entity-reference field--label-hidden field__item\"><article class=\"media media--type-image media--view-mode-default\">\n  <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/2024-05/fruit.jpg\" width=\"800\" height=\"600\" alt=\"Fresh fruit\">\n</div>\n</article>\n</div></div>\n  <div class=\"teaser__content\">\n    <h3 class=\"node__title teaser__title\"><a href=\"/news/fruit\" rel=\"bookmark\"><span class=\"field field--name-title field--type-string field--label-hidden\">Why fruit belongs on your plate</span></a></h3>\n    <div class=\"node__meta teaser__meta\"><time datetime=\"2024-05-25T08:00:00+00:00\" class=\"teaser__date\">25 May 2024</time></div>\n  </div>\n</article></div>\n      <div class=\"views-row\"><article data-history-node-id=\"3\" class=\"node node--type-article node--promoted node--view-mode-teaser teaser\">\n  <div class=\"teaser__image\"><div class=\"field field--name-field-image field--type-entity-reference field--label-hidden field__item\"><article class=\"media media--type-image media--view-mode-default\">\n  <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/2024-05/oats.jpg\" width=\"800\" height=\"600\" alt=\"Rolled oats\">\n</div>\n</article>\n</div></div>\n  <div class=\"teaser__content\">\n    <h3 class=\"node__title teaser__title\"><a href=\"/news/healthy-breakfast\" rel=\"bookmark\"><span class=\"field field--name-title field--type-string field--label-hidden\">Five tips for a healthy breakfast</span></a></h3>\n    <div class=\"node__meta teaser__meta\"><time datetime=\"2024-05-20T08:00:00+00:00\" class=\"teaser__date\">20 May 2024</time></div>\n  </div>\n</article></div>\n    </div>\n  </div>\n</div></div>\n  </div>\n</div></div>\n    </div>\n  </div>\n</article>\n                  </div>\n                </div>\n              </main>\n            </div>\n          </div>\n          <footer class=\"site-footer\">\n            <div class=\"site-footer__inner container\">\n              <div class=\"region region--footer-top\">\n                <nav role=\"navigation\" aria-labelledby=\"block-demo-footer-menu\" id=\"block-demo-footer\" class=\"block block-menu navigation menu--footer\">\n                  <h2 class=\"visually-hidden block__title\" id=\"block-demo-footer-menu\">Footer</h2>\n                  <ul class=\"menu footer-nav__menu\">\n          <li class=\"menu-item footer-nav__menu-item footer-nav__menu-item--link footer-nav__menu-item--level-1\">\n            <a href=\"https://www.acme.com/imprint\" class=\"footer-nav__menu-link footer-nav__menu-link--link footer-nav__menu-link--level-1\">Imprint</a>\n          </li>\n          <li class=\"menu-item footer-nav__menu-item footer-nav__menu-item--link footer-nav__menu-item--level-1\">\n            <a href=\"/about-us\" class=\"footer-nav__menu-link footer-nav__menu-link--link footer-nav__menu-link--level-1\" data-drupal-link-system-path=\"node/2\">Contact</a>\n          </li>\n                  </ul>\n                </nav>\n              </div>\n              <div class=\"region region--footer-bottom\">\n                <div id=\"block-demo-footertext\" class=\"block block-block-content block-block-content-6d3c1a2e-0000-4000-8000-000000000099\">\n                  <div class=\"text-content clearfix field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>© 2024 Acme Demo Kitchen. All rights reserved.</p></div>\n                </div>\n              </div>\n            </div>\n          </footer>\n        </div>\n      </div>\n    </div>\n    <div id=\"cookie-banner\" class=\"cookie-banner\" role=\"dialog\" aria-live=\"polite\" aria-label=\"Cookies\">\n      <div class=\"cookie-banner__inner conta