# Data source: "contentful" (production) or "ccm" (offline, reads a workspace ccm/ directory at build time).
# Default comes from src/generated/config.json (site.frontend.dataSource).
DATA_SOURCE=
# ccm data source: path to workspace/<site>/ccm (absolute or relative to the app dir)
CCM_DIR=

# Public origin of this site (canonical, hreflang, sitemap). Defaults to the live site's baseUrl (same domain after cutover).
SITE_URL=

# Contentful (dataSource: contentful)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Draft mode: Contentful preview URL = https://<host>/api/preview?secret=$PREVIEW_SECRET&path={entry.fields.path}
PREVIEW_SECRET=
# On-demand revalidation: Contentful webhook → POST https://<host>/api/revalidate with header x-revalidate-secret
REVALIDATE_SECRET=
# In-process content cache TTL for the contentful source (ms)
CONTENT_CACHE_TTL_MS=60000
