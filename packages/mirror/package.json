{
  "name": "@harness/mirror",
  "version": "0.3.1",
  "private": true,
  "description": "Mirror mode of the 1:1 recreation: re-serves a page's own markup, styles and scripts, held to a strict verify suite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birkmann/cdr.git",
    "directory": "packages/mirror"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@harness/protocol": "workspace:*",
    "@harness/capture": "workspace:*",
    "@harness/measure": "workspace:*",
    "@harness/recreate": "workspace:*",
    "@harness/mirror-core": "workspace:*",
    "@harness/mirror-capture": "workspace:*",
    "@harness/mirror-design": "workspace:*",
    "@harness/mirror-generate": "workspace:*",
    "@harness/mirror-verify": "workspace:*",
    "@harness/mirror-fix": "workspace:*",
    "yaml": "^2.6.0"
  }
}
